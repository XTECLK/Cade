{
  "name": "cade",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "wrangler": "node scripts/wrangler.mjs",
    "clasp": "clasp",
    "deploy": "node scripts/wrangler.mjs deploy && node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "test": "node --test",
    "docs": "node scripts/docs.mjs",
    "db:migrate": "node scripts/wrangler.mjs d1 migrations apply DB --remote",
    "db:migrate:local": "node scripts/wrangler.mjs d1 migrations apply DB --local",
    "slack:create": "node scripts/slack-app.mjs create",
    "slack:update": "node scripts/slack-app.mjs update",
    "config": "node scripts/config.mjs",
    "google:create": "node scripts/google-app.mjs create",
    "google:update": "node scripts/google-app.mjs update",
    "demo:login": "node scripts/demo/login.mjs",
    "demo:record": "node scripts/demo/record.mjs",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "check": "npm run typecheck && npm test",
    "bundle-diff": "node scripts/bundle-diff.mjs"
  },
  "devDependencies": {
    "@clack/prompts": "^1.8.1",
    "@google/clasp": "^3.4.1",
    "playwright": "^1.64.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.152.0"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@cfworker/json-schema": "4.1.1"
  }
}
